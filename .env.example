# Discovery runs need real model access. Replay never reads this.
ANTHROPIC_API_KEY=sk-ant-...

# Model used for the discovery loop.
CUAS_MODEL=claude-opus-5

# Local target application (fixtures/app).
CUAS_TARGET_URL=http://localhost:4173

# Show the browser during a run. Set to 0 for headless.
CUAS_HEADED=1

# Chrome DevTools Protocol port used for the human handoff (see Phase 8).
CUAS_CDP_PORT=9222

# Operator handoff server.
CUAS_OPERATOR_PORT=4174
